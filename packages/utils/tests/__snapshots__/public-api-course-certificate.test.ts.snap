}
`;

exports[`public certificate contract > keeps the ZPublicApiUpdateCourseCertificate request contract stable 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "design": {
      "description": "Replaces the whole stored design instead of merging, so read it first and send the full object. Sent without theme, it sets theme to design.templateId, as the dashboard editor does.",
      "properties": {
        "accentColor": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "type": "string",
        },
        "descriptionOverride": {
          "maxLength": 500,
          "type": "string",
        },
        "idFormat": {
          "maxLength": 40,
          "type": "string",
        },
        "signatories": {
          "prefixItems": [
            {
              "properties": {
                "enabled": {
                  "default": true,
                  "type": "boolean",
                },
                "name": {
                  "default": "",
                  "maxLength": 80,
                  "type": "string",
                },
                "role": {
                  "default": "",
                  "maxLength": 80,
                  "type": "string",
                },
                "signatureUrl": {
                  "format": "uri",
                  "type": "string",
                },
              },
              "type": "object",
            },
            {
              "properties": {
                "enabled": {
                  "default": true,
                  "type": "boolean",
                },
                "name": {
                  "default": "",
                  "maxLength": 80,
                  "type": "string",
                },
                "role": {
                  "default": "",
                  "maxLength": 80,
                  "type": "string",
                },
                "signatureUrl": {
                  "format": "uri",
                  "type": "string",
                },
              },
              "type": "object",
            },
          ],
          "type": "array",
        },
        "subtitle": {
          "maxLength": 120,
          "type": "string",
        },
        "templateId": {
          "enum": [
            "mp",
            "classique",
            "brutalist",
            "noir",
            "poster",
            "minimal",
          ],
          "type": "string",
        },
      },
      "required": [
        "templateId",
        "accentColor",
        "signatories",
      ],
      "type": "object",
    },
    "emailMessage": {
      "anyOf": [
        {
          "maxLength": 5000,
          "type": "string",
        },
        {
          "type": "null",
        },
      ],
      "description": "Send null to clear it.",
    },
    "isDownloadable": {
      "description": "Controls learner downloads only; the download endpoint works either way.",
      "type": "boolean",
    },
    "theme": {
      "maxLength": 40,
      "minLength": 1,
      "type": "string",
    },
  },
  "type": "object",
}
`;
